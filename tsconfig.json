{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "*": ["./node_modules/@digidem/types/vendor/*/index.d.ts"]
    }
  },
  "include": ["src/frontend/**/*", "app.config.js"],
  "exclude": [
    "node_modules",
    "metro.config.js",
    "babel.config.js",
    "jest.config.js"
  ]
}
